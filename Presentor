<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Universal Presentation</title>
  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      background-color: #0f172a;
      color: #f8fafc;
      overflow: hidden;
      height: 100vh;
      width: 100vw;
    }

    .deck {
      position: relative;
      width: 100%;
      height: 100%;
    }

    .slide {
      position: absolute;
      inset: 0;
      display: flex;
      flex-direction: column;
      justify-content: center;
      padding: 6% 10%;
      opacity: 0;
      visibility: hidden;
      transform: translateY(20px);
      transition: opacity 0.4s ease, transform 0.4s ease, visibility 0.4s;
    }

    .slide.active {
      opacity: 1;
      visibility: visible;
      transform: translateY(0);
    }

    /* Title Slide Styling */
    .slide.title-slide {
      text-align: center;
      align-items: center;
      background: radial-gradient(circle at top right, #1e293b, #0f172a);
    }

    .tag {
      display: inline-block;
      padding: 6px 14px;
      background: rgba(56, 189, 248, 0.15);
      color: #38bdf8;
      border-radius: 999px;
      font-size: 0.9rem;
      font-weight: 600;
      letter-spacing: 0.05em;
      text-transform: uppercase;
      margin-bottom: 1.5rem;
    }

    h1 {
      font-size: clamp(2.5rem, 5vw, 4.5rem);
      line-height: 1.1;
      margin-bottom: 1.5rem;
      max-width: 900px;
    }

    h2 {
      font-size: clamp(2rem, 3.5vw, 3rem);
      color: #38bdf8;
      margin-bottom: 2rem;
    }

    p.subtitle {
      font-size: clamp(1.1rem, 2vw, 1.5rem);
      color: #94a3b8;
      max-width: 700px;
      line-height: 1.6;
    }

    /* Content Layouts */
    ul.points {
      list-style: none;
      display: flex;
      flex-direction: column;
      gap: 1.25rem;
      max-width: 850px;
    }

    ul.points li {
      font-size: clamp(1.2rem, 2vw, 1.6rem);
      line-height: 1.5;
      padding-left: 2rem;
      position: relative;
      color: #e2e8f0;
    }

    ul.points li::before {
      content: "→";
      position: absolute;
      left: 0;
      color: #38bdf8;
      font-weight: bold;
    }

    .grid-cards {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
      gap: 1.5rem;
      margin-top: 1rem;
    }

    .card {
      background: #1e293b;
      border: 1px solid #334155;
      border-radius: 12px;
      padding: 2rem;
    }

    .card h3 {
      color: #38bdf8;
      font-size: 1.4rem;
      margin-bottom: 0.75rem;
    }

    .card p {
      color: #cbd5e1;
      font-size: 1.1rem;
      line-height: 1.5;
    }

    /* Controls & Progress Bar */
    .controls {
      position: fixed;
      bottom: 24px;
      right: 32px;
      display: flex;
      align-items: center;
      gap: 12px;
      z-index: 100;
    }

    button {
      background: #1e293b;
      color: #f8fafc;
      border: 1px solid #334155;
      padding: 10px 18px;
      border-radius: 8px;
      font-size: 1rem;
      cursor: pointer;
      transition: background 0.2s;
    }

    button:hover {
      background: #334155;
    }

    .counter {
      font-size: 0.95rem;
      color: #94a3b8;
      margin-right: 8px;
    }

    .progress-bar {
      position: fixed;
      bottom: 0;
      left: 0;
      height: 4px;
      background: #38bdf8;
      transition: width 0.3s ease;
      z-index: 100;
    }
  </style>
</head>
<body>

  <main class="deck" id="deck">
    
    <!-- SLIDE 1: TITLE -->
    <section class="slide title-slide active">
      <span class="tag">Presentation Topic</span>
      <h1>Your Main Presentation Title Goes Here</h1>
      <p class="subtitle">A short, clear one-sentence summary of what your audience will learn today.</p>
    </section>

    <!-- SLIDE 2: BULLET POINTS -->
    <section class="slide">
      <span class="tag">01 / Key Concept</span>
      <h2>Write Your Slide Takeaway as a Statement</h2>
      <ul class="points">
        <li><strong>First Main Point:</strong> Keep each bullet concise so your audience listens to you instead of reading a wall of text.</li>
        <li><strong>Second Main Point:</strong> Use bold lead-ins to make every idea easy to scan in seconds.</li>
        <li><strong>Third Main Point:</strong> Support your claim with one clear fact, metric, or real-world example.</li>
      </ul>
    </section>

    <!-- SLIDE 3: 3-COLUMN CARDS -->
    <section class="slide">
      <span class="tag">02 / Breakdown</span>
      <h2>Compare Ideas, Steps, or Features</h2>
      <div class="grid-cards">
        <div class="card">
          <h3>Step One</h3>
          <p>Describe the first phase, pillar, or option clearly in two short sentences.</p>
        </div>
        <div class="card">
          <h3>Step Two</h3>
          <p>Describe the second phase, pillar, or option clearly in two short sentences.</p>
        </div>
        <div class="card">
          <h3>Step Three</h3>
          <p>Describe the third phase, pillar, or option clearly in two short sentences.</p>
        </div>
      </div>
    </section>

    <!-- SLIDE 4: CLOSING / CALL TO ACTION -->
    <section class="slide title-slide">
      <span class="tag">Summary</span>
      <h1>Key Takeaway or Call to Action</h1>
      <p class="subtitle">Thank you! Questions & Discussion.</p>
    </section>

  </main>

  <div class="controls">
    <span class="counter" id="counter">1 / 4</span>
    <button id="prevBtn" aria-label="Previous Slide">← Prev</button>
    <button id="nextBtn" aria-label="Next Slide">Next →</button>
  </div>
  <div class="progress-bar" id="progressBar"></div>

  <script>
    const slides = document.querySelectorAll('.slide');
    const prevBtn = document.getElementById('prevBtn');
    const nextBtn = document.getElementById('nextBtn');
    const counter = document.getElementById('counter');
    const progressBar = document.getElementById('progressBar');
    let currentSlide = 0;

    function updateSlides() {
      slides.forEach((slide, index) => {
        slide.classList.toggle('active', index === currentSlide);
      });
      counter.textContent = `${currentSlide + 1} / ${slides.length}`;
      const progress = ((currentSlide + 1) / slides.length) * 100;
      progressBar.style.width = `${progress}%`;
    }

    function nextSlide() {
      currentSlide = (currentSlide + 1) % slides.length;
      updateSlides();
    }

    function prevSlide() {
      currentSlide = (currentSlide - 1 + slides.length) % slides.length;
      updateSlides();
    }

    nextBtn.addEventListener('click', nextSlide);
    prevBtn.addEventListener('click', prevSlide);

    document.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight' || e.key === ' ' || e.key === 'Enter') {
        nextSlide();
      } else if (e.key === 'ArrowLeft') {
        prevSlide();
      }
    });

    updateSlides();
  </script>
</body>
</html>
